{
  "expo": {
    "name": "YGE",
    "slug": "yge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a3a6b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youngge.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.youngge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a3a6b"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.youngge.com"
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
