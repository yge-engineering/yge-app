# Copy to .env.production on the production host. Never commit real
# values. Keep `.env` (development) and `.env.production` separate.

# -------- App identity --------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://app.youngge.com"

# -------- Database (Supabase Postgres) --------
# Get the connection string from Supabase → Project Settings →
# Database → Connection string → URI (use the pooled connection,
# port 6543, with `pgbouncer=true&connection_limit=1` for serverless).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?schema=public"

# -------- Supabase (auth + storage) --------
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# -------- API server --------
API_URL="https://api.youngge.com"
NEXT_PUBLIC_API_URL="https://api.youngge.com"
API_PORT="10000"

# -------- Anthropic --------
ANTHROPIC_API_KEY=""

# -------- Auth secrets (generate with: openssl rand -hex 32) --------
NEXTAUTH_SECRET=""
MOBILE_TOKEN_SECRET=""

# -------- Microsoft SSO (optional but recommended for office users) --------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://api.youngge.com/api/microsoft/callback"

# -------- WebAuthn (passkeys) --------
WEBAUTHN_RP_ID="youngge.com"
WEBAUTHN_RP_NAME="Young General Engineering"
WEBAUTHN_ORIGIN="https://app.youngge.com"

# -------- Observability (optional in dev, recommended for prod) --------
SENTRY_DSN=""

# -------- Feature flags --------
FEATURE_PLANS_TO_ESTIMATE="true"
FEATURE_FORM_FILLER="true"
FEATURE_EMAIL_INTELLIGENCE="false"
